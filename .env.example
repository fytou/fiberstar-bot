# Token Bot Telegram dari @BotFather
BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# Telegram ID Admin (bisa lebih dari satu, pisahkan dengan koma)
# Misal: 123456789,987654321
ADMIN_IDS=

# Nama Tim
DEFAULT_TEAM_NAME=Pekanbaru

# Zona Waktu
TIMEZONE=Asia/Jakarta

# Database File
DB_PATH=fiberstar.db

# Aturan Batas SLA (dalam jam, default Fiberstar adalah 24 jam)
SLA_HOURS=24
